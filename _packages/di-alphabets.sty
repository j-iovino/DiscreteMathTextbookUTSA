%% di-alphabets.sty — shared letter alphabets for mathematical notation
%%
%% PROPOSED split of di-structures.sty (the alphabet block, verbatim, plus the
%% missing uppercase fraktur letters). It depends only on amssymb/amsfonts and
%% mathrsfs, NOT on di-base-*, so that papers that must preserve their own
%% fonts/theorem styles can still use the shared letter names. di-structures.sty
%% would then \RequirePackage{di-alphabets} in place of its own copy of this block.
%%
%% Naming (one and only one macro per symbol across all documents):
%%   \XX   blackboard bold     \mathbb{X}
%%   \cX   calligraphic        \mathcal{X}
%%   \fX   fraktur             \mathfrak{X}   (\fx lowercase for a few letters)
%%   \scrX script              \mathscr{X}
%%   \tX   typewriter          \mathtt{X}
%%   \bk … bar letters

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{di-alphabets}[2026/10/12 Duenez-Iovino letter alphabets]
\RequirePackage{amssymb}
\RequirePackage{mathrsfs}

% ── Number systems (blackboard bold) ────────────────────────────────────────

\newcommand{\CC}{\mathbb{C}}
\newcommand{\EE}{\mathbb{E}}
\newcommand{\FF}{\mathbb{F}}
\newcommand{\GG}{\mathbb{G}}
\newcommand{\KK}{\mathbb{K}}
\newcommand{\MM}{\mathbb{M}}
\newcommand{\NN}{\mathbb{N}}
\newcommand{\PP}{\mathbb{P}}
\newcommand{\QQ}{\mathbb{Q}}
\newcommand{\RR}{\mathbb{R}}
\newcommand{\UU}{\mathbb{U}}    % \newcommand: letter, not operator
\newcommand{\WW}{\mathbb{W}}
\newcommand{\YY}{\mathbb{Y}}
\newcommand{\ZZ}{\mathbb{Z}}

