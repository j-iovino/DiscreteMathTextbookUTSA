% ═══════════════════════════════════════════════════════════════════════════
%% Project-specific additions  (EDIT HERE)
% ═══════════════════════════════════════════════════════════════════════════

% ─── Theorem environments (maatext/amsthm styles; one shared counter as before) ──
% \CDMSharedTheorem{env}{Name}: numbered with the `theorem' counter, but with its own counter
% name (aliascnt), so that \cref reports the right type.
\newcommand{\CDMSharedTheorem}[2]{%
  \newaliascnt{#1}{theorem}%
  \newtheorem{#1}[#1]{#2}%
  \aliascntresetthe{#1}%
}
\newtheorem{theorem}{Theorem}[chapter]
\newtheorem{fact}{Fact}
\CDMSharedTheorem{corollary}{Corollary}
\CDMSharedTheorem{proposition}{Proposition}
\CDMSharedTheorem{lemma}{Lemma}

\theoremstyle{definition}
\CDMSharedTheorem{definition}{Definition}
\CDMSharedTheorem{example}{Example}
\CDMSharedTheorem{examples}{Examples}
\CDMSharedTheorem{exercise}{Exercise}
\CDMSharedTheorem{exercises}{Exercises}
\CDMSharedTheorem{notation}{Notation}

\theoremstyle{remark}
\CDMSharedTheorem{remark}{Remark}
\CDMSharedTheorem{remarks}{Remarks}

% cref names for the plural environments (the singular ones come from di-cleveref)
\crefname{examples}{Example}{Examples}\Crefname{examples}{Example}{Examples}
\crefname{exercises}{Exercise}{Exercises}\Crefname{exercises}{Exercise}{Exercises}
\crefname{remarks}{Remark}{Remarks}\Crefname{remarks}{Remark}{Remarks}

\numberwithin{section}{chapter}
\numberwithin{equation}{chapter}

% ─── Colours and tikz styles for the graph figures ───────────────────────────
\definecolor{EdgeRed}{RGB}{220,40,40}
\definecolor{EdgeGreen}{RGB}{20,140,20}
\tikzset{
  vtx/.style   = {circle, draw=black, fill=white, inner sep=2pt, minimum size=20pt, font=\bfseries},
  ered/.style  = {line width=1.2pt, draw=EdgeRed},
  egreen/.style= {line width=1.2pt, draw=EdgeGreen, dashed}
}

% ─── Relations ───────────────────────────────────────────────────────────────
\newcommand{\rel}[2]{_{#1}\hspace{-3pt}\mathrel{R}_{#2}}
\newcommand{\nrel}[2]{_{#1}\hspace{-3pt}\not\mathrel{R}_{#2}}

% Single index; for multiple indexes see the "AMS Author Handbook, Monograph Classes".
\makeindex
